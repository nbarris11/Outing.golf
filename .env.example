NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_ENV_LABEL=Local

# Local development defaults to demo mode unless real Supabase values are provided.
NEXT_PUBLIC_ENABLE_DEMO=true

# Supabase: local / QA / production should each use separate projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inventory provider selection. Keep these on `mock` until the official adapters are implemented.
OUTING_DESTINATION_PROVIDER=mock
OUTING_GOLF_COURSE_PROVIDER=mock
OUTING_LODGING_PROVIDER=mock
OUTING_TEE_TIME_PROVIDER=mock
OUTING_VACATION_RENTAL_PROVIDER=mock
OUTING_PROVIDER_REQUEST_TIMEOUT_MS=8000

# Future official integrations:
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_SEARCH_RADIUS_METERS=80000

EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_API_HOST=

VRBO_API_KEY=
VRBO_API_BASE_URL=

GOLFNOW_API_KEY=
GOLFNOW_API_BASE_URL=

# Suggested Vercel environment naming:
# Development -> local overrides / preview branches
# Preview / QA -> QA Supabase project
# Production -> production Supabase project

# Vercel also provides these automatically in hosted environments and the app uses them
# for the preview banner and /qa screen:
# VERCEL_ENV
# VERCEL_URL
# VERCEL_BRANCH_URL
# VERCEL_PROJECT_PRODUCTION_URL
